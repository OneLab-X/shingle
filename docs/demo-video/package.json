{
  "name": "shingle-demo-video",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Remotion source for the README demo (docs/media/demo.gif). Regenerate with npm run render.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:mp4": "remotion render src/index.ts Demo ../media/demo.mp4 --codec=h264 --crf=20",
    "gif": "ffmpeg -y -i ../media/demo.mp4 -vf \"fps=12,scale=960:-1:flags=lanczos,split[a][b];[a]palettegen=max_colors=96:stats_mode=diff[p];[b][p]paletteuse=dither=bayer:bayer_scale=4:diff_mode=rectangle\" -loop 0 ../media/demo.gif",
    "render": "npm run render:mp4 && npm run gif"
  },
  "dependencies": {
    "@remotion/cli": "4.0.547",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
