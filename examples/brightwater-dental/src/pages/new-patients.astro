---
import Shell from "../layouts/Shell.astro";
import Panel from "../components/Panel.astro";
import ContactLinks from "../components/ContactLinks.astro";
import site from "../data/site.json";

const facts = site.business.facts as {
  new_patients: { bring: string[]; forms: string; first_visit: string };
  insurance_note?: string;
  payment?: string;
  accessibility?: string;
  spoken_languages?: string[];
};
const np = facts.new_patients;
---

<Shell title="New patients" description="What to bring to your first visit at Brightwater Family Dental, how forms work, insurance and payment options, and access information.">
  <section class="wrap section">
    <p class="eyebrow">New patients</p>
    <h1 class="mt-3">Your first visit</h1>
    <p class="mt-5 lead">{np.first_visit} Here is everything you need to know before you come in.</p>

    <div class="grid mt-10">
      <Panel>
        <h2>What to bring</h2>
        <ul class="checks">{np.bring.map((b) => <li>{b}</li>)}</ul>
      </Panel>
      <Panel>
        <h2>Forms</h2>
        <p>{np.forms}</p>
      </Panel>
      <Panel>
        <h2>Insurance</h2>
        <p>{facts.insurance_note}</p>
      </Panel>
      <Panel>
        <h2>Paying</h2>
        <p>{facts.payment}</p>
      </Panel>
      <Panel tone="outline">
        <h2>Getting here</h2>
        <p>{facts.accessibility}</p>
      </Panel>
      <Panel tone="outline">
        <h2>Languages</h2>
        <p>Our front desk speaks {facts.spoken_languages?.join(" and ")}.</p>
      </Panel>
    </div>
    <h2 class="mt-16">Ready to book?</h2>
    <ContactLinks class="mt-6" show={["tel", "email"]} />
  </section>
</Shell>

<style>
  .lead { font-size: 1.1875rem; }
  .grid { display: grid; gap: 1rem; }
  @media (min-width: 48rem) { .grid { grid-template-columns: repeat(2, 1fr); } }
  .grid h2 { font-size: 1.375rem; }
  .checks { list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .checks li { padding-left: 1.75rem; position: relative; margin-bottom: 0.4rem; }
  .checks li::before { content: ""; position: absolute; left: 0.2rem; top: 0.45em; width: 0.9rem; height: 0.5rem; border-left: 3px solid var(--sh-primary); border-bottom: 3px solid var(--sh-primary); transform: rotate(-45deg); }
</style>
