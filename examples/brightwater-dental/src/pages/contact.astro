---
import Shell from "../layouts/Shell.astro";
import Panel from "../components/Panel.astro";
import ContactLinks from "../components/ContactLinks.astro";
import Hours from "../components/Hours.astro";
import MapEmbed from "../components/MapEmbed.astro";
import site from "../data/site.json";

const { business } = site;
const facts = business.facts as { accessibility?: string; emergency?: string };
---

<Shell title="Contact" description="Call, email or visit Brightwater Family Dental at 418 SE Alder Street, Portland. Opening hours, directions, parking and access.">
  <section class="wrap section">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3">Call, email or visit</h1>
    <ContactLinks class="mt-8" />
    <div class="grid mt-12">
      <div>
        <Panel>
          <h2>Address</h2>
          <address>{business.address_lines.map((l) => <span class="block">{l}</span>)}</address>
          <p class="mt-4">{facts.accessibility}</p>
        </Panel>
        <Panel class="mt-4">
          <h2>Hours</h2>
          <Hours />
        </Panel>
        {facts.emergency && (
          <Panel tone="accent" class="mt-4">
            <h2>Emergencies</h2>
            <p>{facts.emergency}</p>
          </Panel>
        )}
      </div>
      <MapEmbed />
    </div>
  </section>
</Shell>

<style>
  .grid { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 56rem) { .grid { grid-template-columns: 1fr 1.2fr; } }
  .grid h2 { font-size: 1.375rem; }
</style>
