---
/**
 * Handmade signature: a repeating azulejo tile drawn in SVG with the palette's colours.
 * `variant` swaps the motif; `cols`/`rows` set how many tiles the block shows.
 */
interface Props {
  variant?: 1 | 2 | 3;
  cols?: number;
  rows?: number;
  class?: string;
}
const { variant = 1, cols = 6, rows = 1, class: className } = Astro.props;
const id = `az-${variant}-${Math.random().toString(36).slice(2, 7)}`;
---

<svg class={className} viewBox={`0 0 ${cols * 100} ${rows * 100}`} preserveAspectRatio="xMidYMid slice" role="presentation" aria-hidden="true" focusable="false">
  <defs>
    <pattern id={id} width="100" height="100" patternUnits="userSpaceOnUse">
      <rect width="100" height="100" fill="var(--sh-background)"></rect>
      <rect x="3" y="3" width="94" height="94" fill="none" stroke="var(--sh-primary)" stroke-width="3"></rect>
      {
        variant === 1 && (
          <>
            <path d="M50 12 L62 38 L88 50 L62 62 L50 88 L38 62 L12 50 L38 38 Z" fill="var(--sh-primary)"></path>
            <circle cx="50" cy="50" r="9" fill="var(--sh-background)"></circle>
            <circle cx="50" cy="50" r="4" fill="var(--sh-accent)"></circle>
          </>
        )
      }
      {
        variant === 2 && (
          <>
            <circle cx="50" cy="50" r="34" fill="none" stroke="var(--sh-accent)" stroke-width="5"></circle>
            <path d="M50 20 V80 M20 50 H80" stroke="var(--sh-primary)" stroke-width="6"></path>
            <circle cx="50" cy="50" r="10" fill="var(--sh-primary)"></circle>
          </>
        )
      }
      {
        variant === 3 && (
          <>
            <path d="M0 50 Q25 20 50 50 T100 50" fill="none" stroke="var(--sh-primary)" stroke-width="6"></path>
            <path d="M0 74 Q25 44 50 74 T100 74" fill="none" stroke="var(--sh-accent)" stroke-width="5"></path>
            <path d="M0 26 Q25 -4 50 26 T100 26" fill="none" stroke="var(--sh-accent)" stroke-width="5"></path>
          </>
        )
      }
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill={`url(#${id})`}></rect>
</svg>
