---
/**
 * Barro & Luz · one page per language (/pt/, /en/). Direction: handmade. Palette: terracotta-sun.
 * Business facts come from src/data/site.<lang>.json, interface text from src/data/ui.json.
 */
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import ContactLinks from "../../components/ContactLinks.astro";
import Hours from "../../components/Hours.astro";
import OpenStatus from "../../components/OpenStatus.astro";
import MapEmbed from "../../components/MapEmbed.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import Azulejo from "../../components/Azulejo.astro";
import { getSite, langPaths, useT } from "../../lib/i18n";

export const getStaticPaths = langPaths;

const { lang } = Astro.props;
const site = getSite(lang);
const t = useT(lang);
const { business, contact } = site;
const facts = business.facts as {
  story: string;
  products: { name: string; text: string; price: string }[];
  workshop: { title: string; text: string };
  shipping: string;
  find_us?: string;
  labels: Record<string, string>;
  faq: { q: string; a: string }[];
};
const L = facts.labels;
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang,
  mainEntity: facts.faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })),
};
---

<Base jsonld={[faqLd]}>
  <Header
    nav={[
      { href: "#pecas", label: L.products },
      { href: "#oficina", label: L.workshop },
      { href: "#visita", label: L.visit },
    ]}
  />
  <main id="main">
    <section class="wrap hero">
      <div class="copy">
        <p class="eyebrow">{business.category_label} · {business.address?.locality}</p>
        <h1>{business.name}</h1>
        <p class="tagline">{business.tagline}</p>
        <p class="lead">{business.description}</p>
        <ContactLinks show={["tel", "directions"]} />
        <OpenStatus />
      </div>
      <div class="mosaic" aria-hidden="true">
        <Azulejo variant={1} cols={1} class="t t1" />
        <Azulejo variant={2} cols={1} class="t t2" />
        <Azulejo variant={3} cols={1} class="t t3" />
        <Azulejo variant={2} cols={1} class="t t4" />
        <Azulejo variant={1} cols={1} class="t t5" />
        <Azulejo variant={3} cols={1} class="t t6" />
      </div>
    </section>

    <div class="band" aria-hidden="true"><Azulejo variant={1} cols={24} rows={1} /></div>

    <section id="pecas" class="wrap section" aria-labelledby="pecas-title">
      <h2 id="pecas-title">{L.products}</h2>
      <ul class="products">
        {
          facts.products.map((p, i) => (
            <li class:list={{ shift: i % 2 === 1 }}>
              {/* TODO(shingle): product photo, square, one per piece listed in business.json */}
              <PlaceholderImage subject={p.name} width={900} height={900} />
              <div class="info">
                <h3>{p.name}</h3>
                <p>{p.text}</p>
              </div>
              <p class="sticker"><span class="sr-only">{L.price_label}: </span>{p.price}</p>
            </li>
          ))
        }
      </ul>
      <p class="story">{facts.story}</p>
    </section>

    <section id="oficina" class="workshop" aria-labelledby="oficina-title">
      <div class="wrap section grid">
        <div>
          <h2 id="oficina-title">{facts.workshop.title}</h2>
          <p class="big">{facts.workshop.text}</p>
          <ContactLinks class="mt-8" show={["tel", "email"]} />
        </div>
        <div class="ship">
          <h3>{L.shipping}</h3>
          <p>{facts.shipping}</p>
        </div>
      </div>
    </section>

    <section class="wrap section faq" aria-labelledby="faq-title">
      <h2 id="faq-title">{L.faq}</h2>
      <div class="faq-list">
        {
          facts.faq.map((f) => (
            <details>
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="visita" class="wrap section visit" aria-labelledby="visita-title">
      <div>
        <h2 id="visita-title">{L.visit}</h2>
        <address class="addr">{business.address_lines.map((line) => <span>{line}</span>)}</address>
        {facts.find_us && <p>{facts.find_us}</p>}
        <Hours class="mt-8" />
      </div>
      <MapEmbed />
    </section>
  </main>
  <Footer />
</Base>

<style>
  .hero { display: grid; gap: 3rem; align-items: center; padding-block: clamp(2.5rem, 7vw, 5.5rem); }
  @media (min-width: 56rem) { .hero { grid-template-columns: 1.1fr 0.9fr; } }
  .copy { display: grid; gap: 1.25rem; justify-items: start; }
  .copy h1 { font-size: clamp(3rem, 8vw, 6rem); line-height: 0.98; }
  .tagline { font-family: var(--sh-font-display); font-size: clamp(1.4rem, 3vw, 2rem); color: var(--sh-primary); line-height: 1.2; }
  .lead { font-size: 1.1875rem; }
  .mosaic { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.6rem; transform: rotate(-3deg); max-width: 28rem; justify-self: center; width: 100%; }
  .mosaic :global(.t) { width: 100%; aspect-ratio: 1; border-radius: 6px; box-shadow: 0 6px 0 color-mix(in srgb, var(--sh-primary) 22%, transparent); }
  .mosaic :global(.t2), .mosaic :global(.t6) { transform: rotate(90deg); }
  .mosaic :global(.t4) { transform: rotate(180deg); }
  .band { height: 3.25rem; overflow: hidden; border-block: 3px solid var(--sh-primary); }
  .band :global(svg) { width: 100%; height: 100%; display: block; }

  .products { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 2.5rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); }
  .products li { position: relative; }
  .products li.shift { margin-top: 2rem; }
  .products :global(.placeholder-image) { border-radius: calc(var(--sh-radius) * 0.75); aspect-ratio: 1; }
  .products :global(.placeholder-image svg) { height: 100%; }
  .info { margin-top: 1rem; }
  .info h3 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .info p { color: var(--sh-muted); font-size: 1rem; }
  .sticker {
    position: absolute; top: -0.9rem; right: -0.5rem; margin: 0; display: grid; place-items: center;
    min-width: 4.25rem; height: 4.25rem; padding: 0 0.5rem; border-radius: 50%;
    background: var(--sh-primary); color: var(--sh-on-primary); font-family: var(--sh-font-display);
    font-size: 1.375rem; transform: rotate(8deg); box-shadow: 0 3px 0 color-mix(in srgb, var(--sh-text) 40%, transparent);
  }
  .story { margin-top: 3.5rem; font-family: var(--sh-font-display); font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.3; max-width: 36ch; }

  .workshop { background: var(--sh-primary); color: var(--sh-on-primary); }
  .workshop h2, .workshop h3 { color: var(--sh-on-primary); }
  .workshop .grid { display: grid; gap: 3rem; }
  @media (min-width: 56rem) { .workshop .grid { grid-template-columns: 1.4fr 1fr; align-items: center; } }
  .big { font-size: 1.5rem; line-height: 1.35; max-width: 32ch; margin-top: 1rem; }
  .ship { border: 2px dashed color-mix(in srgb, var(--sh-on-primary) 70%, transparent); padding: 1.5rem; border-radius: var(--sh-radius); }
  .ship p { margin-top: 0.5rem; }
  .workshop :global(.btn-primary) { background: var(--sh-on-primary); color: var(--sh-primary); }
  .workshop :global(.btn-quiet) { color: var(--sh-on-primary); border-color: var(--sh-on-primary); }
  .workshop :global(.btn-quiet:hover) { background: color-mix(in srgb, var(--sh-on-primary) 15%, transparent); }

  .faq-list { margin-top: 1.5rem; max-width: 48rem; }
  details { border: var(--sh-border-width) solid var(--sh-border); border-radius: var(--sh-radius); padding: 1rem 1.25rem; margin-bottom: 0.75rem; background: var(--sh-surface); }
  summary { cursor: pointer; font-family: var(--sh-font-display); font-size: 1.25rem; }
  details p { margin-top: 0.5rem; }

  .visit { display: grid; gap: 3rem; }
  @media (min-width: 56rem) { .visit { grid-template-columns: 1fr 1fr; } }
  .addr { display: flex; flex-direction: column; font-size: 1.25rem; font-weight: 700; margin: 1rem 0; }
</style>
