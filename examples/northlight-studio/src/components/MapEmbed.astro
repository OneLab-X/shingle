---
/**
 * Click-to-load map: no third-party request until the visitor asks for it (privacy and speed).
 * Without JavaScript it still offers "Open in Google Maps" and "Directions".
 */
import site from "../data/site.json";
import Icon from "./Icon.astro";

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const { maps, business } = site;
---

{
  maps && (
    <div class:list={["map-embed", className]} data-map>
      <div class="map-panel" data-map-panel>
        <Icon name="map" size={28} />
        <address>
          {business.address_lines.map((line) => (
            <span>{line}</span>
          ))}
        </address>
        <div class="flex flex-wrap gap-3">
          <button type="button" class="btn btn-primary" data-map-load>
            Show map
          </button>
          <a class="btn btn-quiet" href={maps.search} target="_blank" rel="noopener noreferrer">
            Open in Google Maps
          </a>
        </div>
      </div>
      <template data-map-template>
        <iframe
          title={`Map showing ${business.name} at ${business.address_one_line}`}
          src={maps.embed}
          width="600"
          height="400"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        />
      </template>
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>("[data-map]").forEach((root) => {
    root.querySelector("[data-map-load]")?.addEventListener("click", () => {
      const tpl = root.querySelector<HTMLTemplateElement>("[data-map-template]");
      if (!tpl) return;
      root.querySelector("[data-map-panel]")?.replaceWith(tpl.content.cloneNode(true));
      root.querySelector("iframe")?.focus();
    });
  });
</script>

<style>
  .map-embed { aspect-ratio: 3 / 2; background: var(--sh-surface); border: 1px solid var(--sh-border); border-radius: var(--sh-radius); overflow: hidden; }
  .map-panel { height: 100%; display: flex; flex-direction: column; justify-content: center; gap: 1rem; padding: 1.5rem; }
  .map-panel address { display: flex; flex-direction: column; font-size: 1.0625rem; }
  .map-embed :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
</style>
