---
import { url } from "../lib/url";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Base title="Page not found" description="This page does not exist. Go back to the home page." noindex>
  <Header />
  <main id="main" class="wrap section">
    <h1>Page not found</h1>
    <p class="mt-6">The page you were looking for is not here.</p>
    <p class="mt-6"><a class="btn btn-primary" href={url("/")}>Go to the home page</a></p>
  </main>
  <Footer />
</Base>
