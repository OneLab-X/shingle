---
/** Handmade signature: a hand-drawn underline under one key word of a heading. */
interface Props {
  variant?: 1 | 2;
}
const { variant = 1 } = Astro.props;
const paths = {
  1: "M3 9 C 40 3, 80 12, 120 6 S 190 4, 197 8",
  2: "M4 7 C 30 12, 70 2, 110 8 C 140 12, 170 3, 196 9 M30 11 C 70 8, 120 13, 160 10",
};
---

<span class="scribble"><slot /><svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"><path d={paths[variant]} /></svg></span>

<style>
  .scribble { position: relative; white-space: nowrap; display: inline-block; }
  svg { position: absolute; left: -2%; bottom: -0.18em; width: 104%; height: 0.35em; overflow: visible; }
  path { fill: none; stroke: var(--sh-accent); stroke-width: 3.5; stroke-linecap: round; vector-effect: non-scaling-stroke; stroke-dasharray: 260; stroke-dashoffset: 0; }
  @media (prefers-reduced-motion: no-preference) {
    path { animation: draw 900ms ease-out both 200ms; }
    @keyframes draw { from { stroke-dashoffset: 260; } }
  }
</style>
