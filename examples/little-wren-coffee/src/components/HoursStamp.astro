---
/** Handmade signature: the opening hours set around a circular stamp. Always true, no JS needed. */
import site from "../data/site.json";

const text = site.hours.groups
  .filter((g) => g.text !== "Hours not set")
  .map((g) => `${g.label} ${g.text.replace(/:00/g, "")}`.toUpperCase())
  .join(" · ");
---

<figure class="stamp" aria-label={`Opening hours: ${text}`}>
  <svg viewBox="0 0 200 200" aria-hidden="true">
    <defs><path id="ring" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path></defs>
    <circle cx="100" cy="100" r="96" class="outer"></circle>
    <circle cx="100" cy="100" r="62" class="inner"></circle>
    <text class="ring-text"><textPath href="#ring" textLength="486" lengthAdjust="spacingAndGlyphs">{text} ·</textPath></text>
    <g class="cup" transform="translate(70 70)">
      <path d="M8 22 h36 v14 a16 16 0 0 1 -16 16 h-4 a16 16 0 0 1 -16 -16 z"></path>
      <path d="M44 26 h5 a7 7 0 0 1 0 14 h-5"></path>
      <path d="M18 8 c-3 4 3 6 0 10 M28 6 c-3 4 3 6 0 10 M38 8 c-3 4 3 6 0 10"></path>
    </g>
  </svg>
</figure>

<style>
  .stamp { margin: 0; width: clamp(10rem, 22vw, 14rem); aspect-ratio: 1; transform: rotate(-8deg); color: var(--sh-primary); }
  svg { width: 100%; height: 100%; overflow: visible; }
  .outer, .inner { fill: none; stroke: currentColor; }
  .outer { stroke-width: 2.5; fill: var(--sh-background); }
  .inner { stroke-width: 1.5; stroke-dasharray: 3 4; }
  .ring-text { font-family: var(--sh-font-body); font-weight: 800; font-size: 12.5px; fill: currentColor; letter-spacing: 0.04em; }
  .cup path { fill: none; stroke: currentColor; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
</style>
