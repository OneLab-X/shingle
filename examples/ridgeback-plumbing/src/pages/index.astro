---
import { url } from "../lib/url";
/**
 * Ridgeback Plumbing & Gas · single page. Direction: swiss-grid (oversized index numerals,
 * visible hairline grid). Palette: safety-orange. Service-area business: no map pin.
 */
import Base from "../layouts/Base.astro";
import Footer from "../components/Footer.astro";
import Hours from "../components/Hours.astro";
import OpenStatus from "../components/OpenStatus.astro";
import QuoteForm from "../components/QuoteForm.astro";
import Icon from "../components/Icon.astro";
import Todo from "../components/Todo.astro";
import site from "../data/site.json";

const { business, contact } = site;
const facts = business.facts as {
  trade: string;
  emergency?: string;
  services: { name: string; summary: string }[];
  process: { title: string; text: string }[];
  quotes?: string;
  payment?: string;
};
const pad = (n: number) => String(n).padStart(2, "0");
---

<Base>
  <header class="top">
    <div class="wrap bar">
      <a href={url("/")} class="logo">{business.name}</a>
      <nav aria-label="Main" class="links">
        <a href="#services">Services</a>
        <a href="#area">Areas</a>
        <a href="#quote">Quote</a>
      </nav>
      {contact.tel && <a class="btn btn-primary call" href={contact.tel.href}><Icon name="phone" /> {contact.tel.label}</a>}
    </div>
  </header>

  <main id="main">
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
        <p class="eyebrow">{facts.trade} · {business.service_area.slice(0, 2).join(" & ")}</p>
        <h1>{business.tagline}</h1>
        <p class="lead">{business.description}</p>
        <div class="actions">
          {contact.tel && <a class="btn btn-primary big" href={contact.tel.href}><Icon name="phone" /> Call {contact.tel.label}</a>}
          {contact.whatsapp && <a class="btn btn-quiet big" href={contact.whatsapp.href} target="_blank" rel="noopener noreferrer"><Icon name="chat" /> Send photos on WhatsApp</a>}
        </div>
        </div>
        <aside class="today" aria-label="Opening hours">
          <OpenStatus />
          <dl>
            {
              site.hours.groups.map((g) => (
                <div>
                  <dt>{g.label}</dt>
                  <dd>{g.text}</dd>
                </div>
              ))
            }
          </dl>
          {site.hours.note && <p class="note">{site.hours.note}</p>}
        </aside>
      </div>
    </section>

    {
      facts.emergency && (
        <section class="emergency" aria-label="Emergency call-outs">
          <div class="wrap flex flex-wrap items-center justify-between gap-4 py-5">
            <p><strong>Emergency?</strong> {facts.emergency}</p>
            {contact.tel && <a class="btn btn-dark" href={contact.tel.href}>Call now</a>}
          </div>
        </section>
      )
    }

    <section id="services" class="wrap section" aria-labelledby="services-title">
      <div class="head">
        <h2 id="services-title">Services</h2>
        {facts.quotes && <p>{facts.quotes}</p>}
      </div>
      <ol class="indexed">
        {
          facts.services.map((s, i) => (
            <li>
              <span class="num" aria-hidden="true">{pad(i + 1)}</span>
              <div>
                <h3>{s.name}</h3>
                <p>{s.summary}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="process" aria-labelledby="process-title">
      <div class="wrap section">
        <h2 id="process-title">How a job works</h2>
        <ol class="steps">
          {
            facts.process.map((p, i) => (
              <li>
                <span class="num" aria-hidden="true">{pad(i + 1)}</span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section id="area" class="wrap section area" aria-labelledby="area-title">
      <div>
        <h2 id="area-title">Where we work</h2>
        <ul class="chips">{business.service_area.map((a) => <li>{a}</li>)}</ul>
      </div>
      <div>
        <h2>Licensed and insured</h2>
        {/* TODO(shingle): NSW Fair Trading contractor licence number and public liability insurer, exactly as on the licence */}
        <Todo as="p" label="NSW contractor licence number and insurance details" />
        {facts.payment && <p class="mt-6"><strong>Paying:</strong> {facts.payment}</p>}
      </div>
    </section>

    <section id="quote" class="quote-wrap" aria-labelledby="quote-title">
      <div class="wrap section quote-grid">
        <div>
          <h2 id="quote-title">Get a quote</h2>
          <p class="mt-4">Fastest is a call or photos on WhatsApp. Or leave your details and we will call you back.</p>
          <ul class="direct mt-6">
            {contact.tel && <li><a href={contact.tel.href}><Icon name="phone" /> {contact.tel.label}</a></li>}
            {contact.email && <li><a href={contact.email.href}><Icon name="mail" /> {contact.email.label}</a></li>}
          </ul>
          <h3 class="mt-10">Office hours</h3>
          <Hours class="mt-3" />
        </div>
        <QuoteForm />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .top { border-bottom: 2px solid var(--sh-text); position: sticky; top: 0; z-index: 30; background: var(--sh-background); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.75rem; }
  .logo { font-family: var(--sh-font-display); font-weight: 800; font-size: 1.125rem; color: var(--sh-text); text-decoration: none; text-transform: uppercase; letter-spacing: 0.02em; }
  .links { display: flex; gap: 1.5rem; }
  .links a { color: var(--sh-text); text-decoration: none; font-weight: 600; }
  .call { white-space: nowrap; }
  @media (max-width: 48rem) { .links { display: none; } .call { padding-inline: 0.9rem; } .logo { font-size: 0.9375rem; } }

  .hero {
    border-bottom: 1px solid var(--sh-text);
    background-image:
      linear-gradient(to right, color-mix(in srgb, var(--sh-text) 14%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, var(--sh-text) 14%, transparent) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%, 100% 48px;
  }
  .hero-grid { display: grid; gap: 3rem; padding-block: clamp(3rem, 9vw, 7rem); align-items: end; }
  @media (min-width: 56rem) { .hero-grid { grid-template-columns: 1fr 22rem; } }
  .hero-copy { display: grid; gap: 1.5rem; }
  .today { background: var(--sh-background); border: 2px solid var(--sh-text); padding: 1.5rem; box-shadow: 8px 8px 0 var(--sh-primary); }
  .today dl { margin: 1rem 0 0; }
  .today dl div { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; border-top: 1px solid var(--sh-border); }
  .today dt { font-weight: 700; }
  .today dd { margin: 0; font-variant-numeric: tabular-nums; }
  .today .note { margin-top: 0.75rem; font-size: 0.9375rem; font-weight: 600; color: var(--sh-primary); }
  .hero h1 { max-width: 16ch; }
  .lead { font-size: 1.25rem; max-width: 52ch; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .big { font-size: 1.125rem; padding: 1rem 1.4rem; }
  .btn-quiet { background: var(--sh-background); }

  .emergency { background: var(--sh-accent); color: var(--sh-on-accent); }
  .emergency p { margin: 0; font-size: 1.125rem; max-width: none; }
  .btn-dark { background: var(--sh-text); color: var(--sh-background); }

  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem; border-bottom: 2px solid var(--sh-text); padding-bottom: 1rem; }
  .head p { color: var(--sh-muted); margin: 0; }
  .indexed { list-style: none; padding: 0; margin: 0; display: grid; }
  @media (min-width: 56rem) { .indexed { grid-template-columns: 1fr 1fr; column-gap: 3rem; } }
  .indexed li { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding-block: 1.75rem; border-bottom: 1px solid var(--sh-border); }
  .num { font-family: var(--sh-font-display); font-weight: 800; font-size: clamp(3.5rem, 7vw, 6rem); line-height: 0.85; color: var(--sh-primary); font-variant-numeric: tabular-nums; letter-spacing: -0.04em; }
  .indexed h3 { font-size: 1.375rem; margin-bottom: 0.35rem; }

  .process { background: var(--sh-text); color: var(--sh-background); }
  .process h2, .process h3 { color: var(--sh-background); }
  .steps { list-style: none; padding: 0; margin: 2.5rem 0 0; display: grid; gap: 2rem; }
  @media (min-width: 48rem) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .steps li { border-top: 1px solid color-mix(in srgb, var(--sh-background) 40%, transparent); padding-top: 1.25rem; }
  .steps .num { color: var(--sh-accent); display: block; margin-bottom: 1rem; }
  .steps h3 { font-size: 1.375rem; margin-bottom: 0.35rem; }

  .area { display: grid; gap: 3rem; }
  @media (min-width: 56rem) { .area { grid-template-columns: 1fr 1fr; } }
  .chips { list-style: none; padding: 0; margin-top: 1.25rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips li { border: 2px solid var(--sh-text); padding: 0.5rem 0.9rem; font-weight: 700; }
  .area h2 { font-size: calc(var(--sh-h1) * 0.45); margin-bottom: 0.5rem; }

  .quote-wrap { background: var(--sh-surface); border-top: 1px solid var(--sh-border); }
  .quote-grid { display: grid; gap: 3rem; }
  @media (min-width: 56rem) { .quote-grid { grid-template-columns: 0.9fr 1.1fr; } }
  .direct { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .direct a { display: inline-flex; gap: 0.5rem; align-items: center; font-weight: 700; font-size: 1.125rem; color: var(--sh-text); }
</style>
